{
  "manifest_version": 3,
  "name": "AutoReply · 商品评价回复",
  "version": "0.5.0",
  "description": "读取 TikTok Shop 马来西亚站／新加坡站评价，按商品资料生成并校验回复；保留本机演示，不自动发布。",
  "minimum_chrome_version": "142",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 AutoReply 侧边栏"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' blob: https:; media-src 'self' blob: https:; connect-src 'none'; style-src 'self'; base-uri 'none'"
  },
  "key": ""
}
