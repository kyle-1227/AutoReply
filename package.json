{
  "name": "autoreply-extension",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Chrome and Edge side panel for product reviews, with no runtime dependencies.",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
